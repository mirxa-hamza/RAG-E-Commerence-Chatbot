# ─── Secrets ────────────────────────────────────────────────────────────────
# Never commit real API keys. .env.example IS tracked and is the template.
.env
.env.*
!.env.example

# ─── Python ─────────────────────────────────────────────────────────────────
venv/
.venv/
.venv-app/
node_modules/
.next/
*.tsbuildinfo
playwright-report/
test-results/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Generated index state ──────────────────────────────────────────────────
# The vector store is DERIVED data: it is rebuilt from data/ by scripts/ingest.py.
# It is large, binary, unmergeable, and only valid for the exact embedding model and
# chunk settings that produced it — so it must never be committed. Each collaborator
# builds their own.
storage/

# ─── Source data ────────────────────────────────────────────────────────────
# The Amazon Fashion 2023 JSONL dumps stay out of the repo: multi-gigabyte, publicly
# downloadable, and unrelated to code changes. Share them out of band if needed.
# data/.gitkeep is tracked so the folder exists after a fresh clone.
data/*
!data/.gitkeep

# ─── Test artifacts ─────────────────────────────────────────────────────────
tests/fixtures/

# ─── Logs & OS / editor junk ────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local backups produced by scripts/backup.py - never in git.
backups/

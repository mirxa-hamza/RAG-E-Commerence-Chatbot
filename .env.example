# Copy this file to .env and fill in what you need:
#
#   Windows:        copy .env.example .env
#   macOS/Linux:    cp .env.example .env
#
# The ONLY setting you must provide is a key for whichever LLM answers questions, plus a
# running local MongoDB. Chunking, embedding, the vector store and re-ranking all run on
# this machine and need no keys.
#
# Every value below is the default, commented out. Uncomment only what you want to change.
# A key set twice in this file silently keeps the LAST value - the app warns about that at
# startup, but it is easier not to do it.


# ======================================================================================
# 1. ANSWER GENERATION  (the one thing that leaves this machine)
# ======================================================================================
# Who writes the answer: groq | gemini
# LLM_PROVIDER=groq

# --- Groq (LLM_PROVIDER=groq) ---
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Groq deprecates models periodically. If you get "model not found", check
# https://console.groq.com/docs/models and update this.
# GROQ_MODEL=openai/gpt-oss-20b
# How hard a reasoning model thinks: "" | low | medium | high. Only gpt-oss models accept
# it. Every reasoning token is one the answer does not get, so "low" is the default.
# GROQ_REASONING_EFFORT=low

# --- Gemini (LLM_PROVIDER=gemini) ---
# Free key, no card: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_VERSION=v1beta

# --- Shared by both ---
# Low temperature: grounded answers, not creative ones.
# LLM_TEMPERATURE=0.2
# Completion budget. On a reasoning model the thinking comes out of the same allowance, so
# too low a value returns an EMPTY answer rather than a short one.
# LLM_MAX_TOKENS=900
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3


# ======================================================================================
# 2. ANSWER LENGTH
# ======================================================================================
# brief (70 words) | concise (140) | standard (300) | detailed (700)
# ANSWER_STYLE=brief
# Override the style's word budget directly.
# ANSWER_MAX_WORDS=70
# Most bullets an answer may use. Unbounded bullets are how "summarise everything" sneaks
# past a word budget.
# ANSWER_MAX_BULLETS=6


# ======================================================================================
# 3. EMBEDDINGS  (local, no key)
# ======================================================================================
# Downloaded once (~130MB) on first run, then cached. bge-small has a 512-token window, so
# a ~300-word chunk fits without being silently truncated.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge models want an instruction prefix on the QUERY side only. Set to "" for a model that
# does not (e.g. all-MiniLM-L6-v2).
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# Lower this if embedding a large batch exhausts memory.
# EMBEDDING_BATCH_SIZE=64


# ======================================================================================
# 4. CHUNKING  (semantic, local)
# ======================================================================================
# Cut where the MEANING changes, not where a word count runs out. Every sentence is
# embedded with its neighbours and a boundary is placed wherever the distance between
# consecutive windows spikes. Used by chunk_review() (PLAN.md Phase 2), which
# short-circuits to "one review = one chunk" for anything under SEMANTIC_MIN_CHUNK_WORDS -
# most reviews never hit the full breakpoint-detection logic below.
#
# CHANGING ANY OF THESE REQUIRES A FULL RE-INGEST:
#     python scripts/ingest_ecommerce.py --force
# Different settings produce different chunk text and therefore different vectors. Mixing
# two settings in one collection does not error - it quietly ruins every measurement.

# Boundary threshold, as a percentile of THIS document's own distance distribution.
# Lower = more, smaller chunks. 95 is the usual starting point.
# SEMANTIC_BREAKPOINT_PERCENTILE=95
# Sentences embedded with N neighbours each side. A lone sentence embeds noisily ("It does
# not." has no topic at all) and that noise reads as a false boundary; 1 smooths it.
# SEMANTIC_BUFFER_SIZE=1
# Size bounds in words. The floor merges away one-line chunks that would otherwise each
# occupy a top_k slot; the ceiling stops a passage with no detectable topic change
# becoming one chunk the embedding model would truncate anyway.
# SEMANTIC_MIN_CHUNK_WORDS=60
# SEMANTIC_MAX_CHUNK_WORDS=300


# ======================================================================================
# 5. RETRIEVAL  (the semantic_review_search tool)
# ======================================================================================
# How many passages reach the model per question, and the ceiling a client may ask for.
# TOP_K=4
# MAX_TOP_K=20
# Candidates fetched before re-ranking narrows them. A bi-encoder is fast but coarse; the
# cross-encoder is what actually decides.
# RETRIEVAL_CANDIDATES=10

# Hybrid search: BM25 keyword ranking fused with vector ranking (Reciprocal Rank Fusion).
# Dense vectors are weak on exact terms; BM25 is strong there, and vice versa.
# HYBRID_ENABLED=true
# RRF_K=60
# The lexical half on its own: on | off
# KEYWORD_SEARCH=on

# Cross-encoder re-ranking, on this machine (~80MB, downloaded on first question).
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Logits, not probabilities: irrelevant pairs sit well below zero. Nothing above this floor
# means the tool reports zero usable results - the agent is instructed to say so plainly
# rather than answering from nothing (PLAN.md's empty-result handling).
# MIN_RERANK_SCORE=-6.0
# Fallback floor used when re-ranking is off (cosine similarity, 0..1).
# MIN_SIMILARITY=0.15

# Also pull the chunks immediately before/after each hit. Semantic chunks do not overlap by
# design, so this is what stops the model reading one side of a boundary in isolation.
# NEIGHBOR_EXPANSION=0
# Cap on the assembled CONTEXT block, independent of top_k.
# MAX_CONTEXT_CHARS=6000
# Maximum characters per review excerpt and total review evidence items returned to the
# model. These are the biggest token-savers for review-heavy questions.
# REVIEW_EXCERPT_CHARS=700
# REVIEW_MAX_RESULTS_TO_MODEL=6

# Repeated questions skip retrieval and the LLM call. NOTE: disabled for the agentic
# router regardless of this flag (see PLAN.md) - an answer now depends on which tools
# were called and on stored preferences, so a cache keyed on question text alone is
# unsound. Left here for anything that still calls the retrieval pipeline directly.
# ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_SIZE=256
# ANSWER_CACHE_TTL_SECONDS=3600


# ======================================================================================
# 6. CONVERSATION
# ======================================================================================
# HISTORY_TURNS=2
# MAX_HISTORY_CHARS=3000
# Rewrite "what about the second one?" into a standalone question before retrieving - the
# raw follow-up embeds to nothing useful. Costs one small extra LLM call per follow-up.
# REWRITE_FOLLOWUPS=true

# Local fast paths for obvious catalog questions, such as "best rated products". These
# skip the LLM entirely and answer directly from MongoDB.
# DIRECT_ANSWERS_ENABLED=true


# ======================================================================================
# 7. VECTOR STORE  (ChromaDB)
# ======================================================================================
# Where the index is written in embedded mode. Relative paths resolve against the project
# root, not the current directory.
# CHROMA_DIR=storage/chroma_db
# Point this somewhere new before re-ingesting with different chunking settings, so the two
# generations of vectors never mix.
# CHROMA_COLLECTION=amazon_fashion_reviews_384
# CHROMA_ADD_BATCH=1000

# embedded (PersistentClient, default, this process) | server (HttpClient, talking to a
# chromadb container - see PLAN.md Phase 6). HOST/PORT only matter in server mode.
# CHROMA_MODE=embedded
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Where the raw project files (not the index) live.
# DATA_DIR=data


# ======================================================================================
# 8. E-COMMERCE INGESTION  (Amazon Fashion 2023 dataset -> MongoDB + ChromaDB)
# ======================================================================================
# Where the raw dataset files are. Download both from the Amazon Reviews 2023 dataset and
# place them under data/ (relative paths resolve against the project root).
# AMAZON_META_PATH=data/meta_Amazon_Fashion.jsonl
# AMAZON_REVIEWS_PATH=data/Amazon_Fashion.jsonl

# How many products (ranked by review count) scripts/ingest_ecommerce.py ingests. The full
# dataset is millions of products; this is what makes local, CPU-only embedding practical.
# PRODUCT_SUBSET_SIZE=5000
# MONGO_PRODUCTS_COLLECTION=products

# Reviews not detected as English are dropped before embedding (langdetect, seeded for
# reproducible re-ingests) - the embedding model above is English-tuned, and a
# foreign-language review would embed to noise rather than anything retrievable.
# REVIEW_LANGUAGE_FILTER_ENABLED=true


# ======================================================================================
# 9. AGENTIC ROUTER
# ======================================================================================
# Caps how many tool-call <-> LLM round-trips one chat turn may take, so a confused model
# can't loop forever calling tools instead of answering.
# AGENT_MAX_TOOL_ROUNDTRIPS=2
# Enable LangGraph's in-process checkpointer/store. MongoDB remains the persistent source
# of saved conversations and account preferences; the checkpointer gives LangChain short
# term memory inside a running backend process and is seeded from MongoDB after restart.
# AGENT_CHECKPOINTING_ENABLED=true
# Retry transient provider failures through LangChain middleware before surfacing an API
# error. Provider SDK retries may also apply, so keep these small.
# AGENT_MODEL_RETRIES=1
# AGENT_MODEL_RETRY_INITIAL_DELAY_SECONDS=0.5
# AGENT_MODEL_RETRY_MAX_DELAY_SECONDS=8
# Summarise older conversation state when the model approaches this fraction of its context
# window. If a model exposes no context profile, the token fallback is used instead.
# AGENT_SUMMARY_TRIGGER_FRACTION=0.75
# AGENT_SUMMARY_KEEP_MESSAGES=16
# AGENT_SUMMARY_FALLBACK_TOKENS=24000
# Clear old retrieved tool payloads once context grows; recent tool results are preserved
# so the final answer can still cite current evidence.
# AGENT_TOOL_CLEAR_TRIGGER_TOKENS=18000
# AGENT_TOOL_CLEAR_KEEP=2
# AGENT_TOOL_CLEAR_AT_LEAST_TOKENS=4000
# AGENT_TIMEOUT_SECONDS=120
# AGENT_TRACING_ENABLED=false
# APP_WARMUP_ENABLED=true
# APP_WARMUP_DELAY_SECONDS=20


# ======================================================================================
# 10. ACCOUNTS  (local MongoDB)
# ======================================================================================
# Needs MongoDB running locally (or point at the `mongo` service name inside Docker - see
# PLAN.md Phase 6). Without it the app starts and serves requests, but nobody can sign in,
# and the product catalog has nowhere to live.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=ecommerce_agent

# Generated and written back into .env on first run if left blank. Do not commit it, and do
# not change it unless you want to sign everybody out.
JWT_SECRET=
# JWT_EXPIRE_HOURS=12

# Chat history, stored in the same database.
# SESSION_PAGE_SIZE=10
# MAX_SESSION_MESSAGES=400


# ======================================================================================
# 11. MISC
# ======================================================================================
# This is an API-only backend; the frontend is a separate Next.js app (PLAN.md Phase 5)
# that proxies requests server-side, which needs no CORS entry at all. Set this only if a
# browser calls the API directly from a different origin during local dev. Comma-separated.
# CORS_ORIGINS=
# LOG_LEVEL=INFO
# "text" for a human at a terminal, "json" for anything that ships logs somewhere.
# LOG_FORMAT=text

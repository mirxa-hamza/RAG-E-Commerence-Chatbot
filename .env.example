# Copy this file to .env and fill in what you need:
#
#   Windows:        copy .env.example .env
#   macOS/Linux:    cp .env.example .env
#
# The ONLY setting you must provide is a key for whichever LLM answers questions. Chunking,
# embedding, the vector store and re-ranking all run on this machine and need no keys.
#
# Every value below is the default, commented out. Uncomment only what you want to change.
# A key set twice in this file silently keeps the LAST value - the app warns about that at
# startup, but it is easier not to do it.


# ======================================================================================
# 1. ANSWER GENERATION  (the one thing that leaves this machine)
# ======================================================================================
# Who writes the answer: groq | gemini
# LLM_PROVIDER=groq

# --- Groq (LLM_PROVIDER=groq) ---
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Groq deprecates models periodically. If you get "model not found", check
# https://console.groq.com/docs/models and update this.
# GROQ_MODEL=openai/gpt-oss-20b
# How hard a reasoning model thinks: "" | low | medium | high. Only gpt-oss models accept
# it. Every reasoning token is one the answer does not get, so "low" is the default.
# GROQ_REASONING_EFFORT=low

# --- Gemini (LLM_PROVIDER=gemini) ---
# Free key, no card: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_VERSION=v1beta

# --- Shared by both ---
# Low temperature: grounded answers, not creative ones.
# LLM_TEMPERATURE=0.2
# Completion budget. On a reasoning model the thinking comes out of the same allowance, so
# too low a value returns an EMPTY answer rather than a short one.
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3


# ======================================================================================
# 2. ANSWER LENGTH
# ======================================================================================
# brief (70 words) | concise (140) | standard (300) | detailed (700)
# ANSWER_STYLE=concise
# Override the style's word budget directly.
# ANSWER_MAX_WORDS=140
# Most bullets an answer may use. Unbounded bullets are how "summarise everything" sneaks
# past a word budget.
# ANSWER_MAX_BULLETS=6


# ======================================================================================
# 3. EMBEDDINGS  (local, no key)
# ======================================================================================
# Downloaded once (~130MB) on first run, then cached. bge-small has a 512-token window, so
# a ~300-word chunk fits without being silently truncated.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge models want an instruction prefix on the QUERY side only. Set to "" for a model that
# does not (e.g. all-MiniLM-L6-v2).
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# Lower this if embedding a big book exhausts memory.
# EMBEDDING_BATCH_SIZE=64


# ======================================================================================
# 4. CHUNKING  (semantic, local)
# ======================================================================================
# Cut where the MEANING changes, not where a word count runs out. Every sentence is
# embedded with its neighbours and a boundary is placed wherever the distance between
# consecutive windows spikes.
#
# CHANGING ANY OF THESE REQUIRES A FULL RE-INGEST:
#     python scripts/ingest.py --force
# Different settings produce different chunk text and therefore different vectors. Mixing
# two settings in one collection does not error - it quietly ruins every measurement.

# Boundary threshold, as a percentile of THIS document's own distance distribution.
# Lower = more, smaller chunks. 95 is the usual starting point.
# SEMANTIC_BREAKPOINT_PERCENTILE=95
# Sentences embedded with N neighbours each side. A lone sentence embeds noisily ("It does
# not." has no topic at all) and that noise reads as a false boundary; 1 smooths it.
# SEMANTIC_BUFFER_SIZE=1
# Size bounds in words. The floor merges away one-line chunks (headings, page furniture)
# that would otherwise each occupy a top_k slot; the ceiling stops a passage with no
# detectable topic change becoming one chunk the embedding model would truncate anyway.
# SEMANTIC_MIN_CHUNK_WORDS=60
# SEMANTIC_MAX_CHUNK_WORDS=300


# ======================================================================================
# 5. RETRIEVAL
# ======================================================================================
# How many passages reach the model per question, and the ceiling a client may ask for.
# TOP_K=4
# MAX_TOP_K=20
# Candidates fetched before re-ranking narrows them. A bi-encoder is fast but coarse; the
# cross-encoder is what actually decides.
# RETRIEVAL_CANDIDATES=30

# Hybrid search: BM25 keyword ranking fused with vector ranking (Reciprocal Rank Fusion).
# Dense vectors are weak on exact terms ("A* search"); BM25 is strong there, and vice versa.
# HYBRID_ENABLED=true
# RRF_K=60
# The lexical half on its own: on | off
# KEYWORD_SEARCH=on

# Cross-encoder re-ranking, on this machine (~80MB, downloaded on first question).
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Logits, not probabilities: irrelevant pairs sit well below zero. Nothing above this floor
# means "not in these documents", answered WITHOUT calling the LLM.
# MIN_RERANK_SCORE=-6.0
# Fallback floor used when re-ranking is off (cosine similarity, 0..1).
# MIN_SIMILARITY=0.15

# Also pull the chunks immediately before/after each hit. Semantic chunks do not overlap by
# design, so this is what stops the model reading one side of a boundary in isolation.
# NEIGHBOR_EXPANSION=1
# Cap on the assembled CONTEXT block, independent of top_k.
# MAX_CONTEXT_CHARS=24000

# Repeated questions skip retrieval and the LLM call. Per user; dies when that user's
# documents change. Set false while measuring, so cache hits do not confuse the numbers.
# ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_SIZE=256
# ANSWER_CACHE_TTL_SECONDS=3600


# ======================================================================================
# 6. CONVERSATION
# ======================================================================================
# HISTORY_TURNS=4
# MAX_HISTORY_CHARS=8000
# Rewrite "what about the second one?" into a standalone question before retrieving - the
# raw follow-up embeds to nothing useful. Costs one small extra LLM call per follow-up.
# REWRITE_FOLLOWUPS=true


# ======================================================================================
# 7. STORAGE
# ======================================================================================
# Where PDFs live and where the index is written. Relative paths resolve against the
# project root, not the current directory.
# DATA_DIR=data
# CHROMA_DIR=storage/chroma_db
# Point this somewhere new before re-ingesting with different chunking settings, so the two
# generations of vectors never mix.
# CHROMA_COLLECTION=rag_documents
# CHROMA_ADD_BATCH=1000

# Per-file upload cap and per-account total, both in MB.
# MAX_UPLOAD_MB=100
# MAX_USER_STORAGE_MB=2048

# Scanned/image-only PDFs. Needs `pip install pytesseract pillow` AND the Tesseract binary.
# With it off, such PDFs are reported as skipped rather than failing.
# OCR_ENABLED=false
# OCR_DPI=200
# OCR_LANG=eng


# ======================================================================================
# 8. ACCOUNTS  (local MongoDB)
# ======================================================================================
# Needs MongoDB running locally. Without it the app starts and serves pages, but nobody
# can sign in.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=rag_app

# Generated and written back into .env on first run if left blank. Do not commit it, and do
# not change it unless you want to sign everybody out.
JWT_SECRET=
# JWT_EXPIRE_HOURS=12

# Chat history, stored in the same database.
# SESSION_PAGE_SIZE=10
# MAX_SESSION_MESSAGES=400


# ======================================================================================
# 9. MISC
# ======================================================================================
# The UI is served by this same process, so the default is same-origin only. Set this only
# if you deliberately serve the frontend from somewhere else. Comma-separated.
# CORS_ORIGINS=
# LOG_LEVEL=INFO
# "text" for a human at a terminal, "json" for anything that ships logs somewhere.
# LOG_FORMAT=text
